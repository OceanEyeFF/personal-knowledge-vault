/* ===================================================
 * Personal Knowledge Vault - 明亮主题 (Light Theme)
 * Phase 2B M10~M11 GUI 基础框架 + 归档/设置视图
 * =================================================== */

/* 主窗口与全局背景 */
QMainWindow,
QWidget {
    background-color: #f5f5f5;
    color: #2c2c2c;
    font-family: "Microsoft YaHei UI", "PingFang SC", "Segoe UI", sans-serif;
    font-size: 13px;
}

/* 分隔器 */
QSplitter::handle {
    background-color: #d0d0d0;
}
QSplitter::handle:horizontal {
    width: 1px;
}
QSplitter::handle:vertical {
    height: 1px;
}

/* 表格视图 */
QTableView {
    background-color: #ffffff;
    alternate-background-color: #f0f0f0;
    gridline-color: #e0e0e0;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
    outline: none;
}
QTableView::item {
    padding: 4px 8px;
    border: none;
}
QTableView::item:selected {
    background-color: #0078d4;
    color: #ffffff;
}
QTableView::item:hover:!selected {
    background-color: #e5f3fb;
}
QHeaderView::section {
    background-color: #f0f0f0;
    color: #2c2c2c;
    padding: 6px 8px;
    border: none;
    border-right: 1px solid #d0d0d0;
    border-bottom: 1px solid #d0d0d0;
    font-weight: 600;
}
QHeaderView::section:last {
    border-right: none;
}

/* 树形视图 */
QTreeView {
    background-color: #ffffff;
    alternate-background-color: #f7f7f7;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
    outline: none;
}
QTreeView::item {
    padding: 4px 6px;
    min-height: 24px;
}
QTreeView::item:selected {
    background-color: #0078d4;
    color: #ffffff;
}
QTreeView::item:hover:!selected {
    background-color: #e5f3fb;
}
QTreeView::branch:selected {
    background-color: #0078d4;
}

/* 文本编辑框（Markdown 预览） */
QTextEdit {
    background-color: #ffffff;
    color: #2c2c2c;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 12px;
    font-size: 14px;
    line-height: 1.6;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
}
QTextEdit[readOnly="true"] {
    background-color: #fafafa;
}

/* 按钮 */
QPushButton {
    background-color: #0078d4;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 13px;
    min-height: 28px;
}
QPushButton:hover {
    background-color: #106ebe;
}
QPushButton:pressed {
    background-color: #005a9e;
}
QPushButton:disabled {
    background-color: #c0c0c0;
    color: #8a8a8a;
}
QPushButton[flat="true"] {
    background-color: transparent;
    color: #0078d4;
    border: 1px solid #0078d4;
}
QPushButton[flat="true"]:hover {
    background-color: #e5f3fb;
}

/* 输入框 */
QLineEdit {
    background-color: #ffffff;
    color: #2c2c2c;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 13px;
    min-height: 28px;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
}
QLineEdit:focus {
    border-color: #0078d4;
    outline: none;
}
QLineEdit:disabled {
    background-color: #f0f0f0;
    color: #8a8a8a;
}
QLineEdit::placeholder {
    color: #a0a0a0;
}

/* 下拉框 */
QComboBox {
    background-color: #ffffff;
    color: #2c2c2c;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 28px;
    selection-background-color: #0078d4;
}
QComboBox:focus {
    border-color: #0078d4;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
}

/* 菜单栏 */
QMenuBar {
    background-color: #f5f5f5;
    color: #2c2c2c;
    border-bottom: 1px solid #d0d0d0;
    padding: 2px;
}
QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
    border-radius: 3px;
}
QMenuBar::item:selected {
    background-color: #e0e0e0;
}
QMenuBar::item:pressed {
    background-color: #d0d0d0;
}

/* 菜单 */
QMenu {
    background-color: #ffffff;
    color: #2c2c2c;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 4px 0;
}
QMenu::item {
    padding: 6px 24px 6px 16px;
}
QMenu::item:selected {
    background-color: #0078d4;
    color: #ffffff;
}
QMenu::separator {
    height: 1px;
    background-color: #e0e0e0;
    margin: 4px 8px;
}

/* 状态栏 */
QStatusBar {
    background-color: #f0f0f0;
    color: #555555;
    border-top: 1px solid #d0d0d0;
    font-size: 12px;
    padding: 2px 8px;
}
QStatusBar::item {
    border: none;
}

/* 列表部件 */
QListWidget {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    outline: none;
}
QListWidget::item {
    padding: 8px 12px;
    border-radius: 3px;
    margin: 1px 4px;
}
QListWidget::item:selected {
    background-color: #0078d4;
    color: #ffffff;
}
QListWidget::item:hover:!selected {
    background-color: #e5f3fb;
}

/* 标签 */
QLabel {
    color: #2c2c2c;
    background-color: transparent;
}

/* 滚动条 */
QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background-color: #c0c0c0;
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background-color: #a0a0a0;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}
QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background-color: #c0c0c0;
    border-radius: 4px;
    min-width: 20px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #a0a0a0;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
}

/* 工具栏 */
QToolBar {
    background-color: #f5f5f5;
    border-bottom: 1px solid #d0d0d0;
    spacing: 4px;
    padding: 2px;
}

/* 框架/分组框 */
QGroupBox {
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    margin-top: 12px;
    padding: 16px 12px 12px 12px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    background-color: #f5f5f5;
    color: #2c2c2c;
}

/* 选项卡部件（归档视图） */
QTabWidget::pane {
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    background-color: #ffffff;
    padding: 8px;
}
QTabBar::tab {
    background-color: #e8e8e8;
    color: #555555;
    border: 1px solid #d0d0d0;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 6px 16px;
    margin-right: 2px;
    min-width: 80px;
}
QTabBar::tab:selected {
    background-color: #ffffff;
    color: #2c2c2c;
    border-bottom: 2px solid #0078d4;
    font-weight: 600;
}
QTabBar::tab:hover:!selected {
    background-color: #e5f3fb;
    color: #2c2c2c;
}

/* 进度条（归档进度 + 统计条） */
QProgressBar {
    background-color: #e0e0e0;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    text-align: center;
    color: #2c2c2c;
    font-size: 12px;
    min-height: 20px;
}
QProgressBar::chunk {
    background-color: #0078d4;
    border-radius: 3px;
}

/* 文本区域（归档文本输入） */
QPlainTextEdit {
    background-color: #ffffff;
    color: #2c2c2c;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 8px;
    font-size: 13px;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
}
QPlainTextEdit:focus {
    border-color: #0078d4;
}

/* 表单标签（QFormLayout 中的标签） */
QLabel[formLabel="true"] {
    color: #555555;
    font-size: 13px;
    padding-right: 8px;
    min-width: 80px;
}

/* ===================================================
 * M12 UI Overhaul - 新增组件样式 (Light)
 * =================================================== */

/* 导航面板 */
#nav_panel {
    background-color: #f0f0f0;
    border-right: 1px solid #d0d0d0;
}
#nav_list {
    background-color: transparent;
    border: none;
    outline: none;
}
#nav_list::item {
    padding: 10px 15px;
    color: #555555;
    border-left: 3px solid transparent;
}
#nav_list::item:hover {
    background-color: #e5e5e5;
}
#nav_list::item:selected {
    background-color: #e0e0e0;
    color: #0078d4;
    border-left: 3px solid #0078d4;
    font-weight: 600;
}

/* 会话侧栏 */
#session_sidebar {
    background-color: #f5f5f5;
    border-right: 1px solid #d0d0d0;
}
#session_list {
    background-color: transparent;
    border: none;
}
#session_list::item {
    padding: 8px 12px;
    border-bottom: 1px solid #e0e0e0;
}
#session_list::item:hover {
    background-color: #ececec;
}
#session_list::item:selected {
    background-color: #e3f2fd;
    color: #2196f3;
}

/* Token 面板 */
#token_panel {
    background-color: #fdfdfd;
    border-top: 1px solid #e0e0e0;
    padding: 4px;
}
#token_panel_title {
    font-weight: bold;
    font-size: 14px;
    color: #333333;
    padding-bottom: 2px;
}
#token_warning {
    background-color: #fff3e0;
    color: #e65100;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

/* 消息显示区 */
#message_display {
    background-color: #ffffff;
    border: none;
}

/* 聊天输入框 */
#chat_input {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 6px;
    padding: 8px;
    font-size: 14px;
}
#chat_input:focus {
    border-color: #0078d4;
}

/* 自动补全弹窗 */
#autocomplete_popup {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
}

/* 归档结果框 */
#archive_result_frame {
    background-color: #f9f9f9;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 12px;
    margin-top: 8px;
}
#archive_result_title {
    font-weight: bold;
    font-size: 15px;
    color: #2c3e50;
    margin-bottom: 6px;
}

/* 按钮变体 */
#btn_send_to_chat {
    background-color: #4caf50;
    color: white;
    border-radius: 4px;
    padding: 6px 12px;
    font-weight: 600;
}
#btn_send_to_chat:hover {
    background-color: #45a049;
}
#btn_stop {
    background-color: #f44336;
    color: white;
    border-radius: 4px;
    padding: 6px 12px;
    font-weight: 600;
}
#btn_stop:hover {
    background-color: #d32f2f;
}

/* 语义化属性选择器 */
QLabel[class="panel-header"] {
    font-weight: bold;
    font-size: 14px;
    color: #333333;
    padding: 4px 0;
}
QLabel[class="text-muted"] {
    color: #757575;
    font-size: 12px;
}
QLabel[status="success"] {
    color: #4caf50;
    font-weight: 600;
}
QLabel[status="error"] {
    color: #f44336;
    font-weight: 600;
}
QLabel[status="muted"] {
    color: #9e9e9e;
}
