# Personal Knowledge Vault - Environment Variables Template
# Copy this file to .env and replace placeholder values
# Lines starting with # are comments and safe to keep

# ====================== OPENAI-COMPATIBLE LLM ======================
# Used for analysis, summarization, and tagging.
# Priority: PKV_LLM_* env > config/config.yaml ai.llm.* > defaults
PKV_LLM_BASE_URL=https://api.deepseek.com/v1
PKV_LLM_API_KEY=your-llm-api-key-here
PKV_LLM_MODEL=deepseek-chat

# ====================== OPENAI-COMPATIBLE EMBEDDING =================
# Used for embeddings and vector/hybrid search.
# Priority: PKV_EMBD_* env > config/config.yaml ai.embedding.* > defaults
# Examples:
#   PKV_EMBD_BASE_URL=https://api.openai.com/v1       (OpenAI official)
#   PKV_EMBD_BASE_URL=http://localhost:1234/v1        (LM Studio)
#   PKV_EMBD_BASE_URL=http://localhost:11434/v1       (Ollama)
#   PKV_EMBD_BASE_URL=https://your-proxy.com/v1       (API proxy)
PKV_EMBD_BASE_URL=https://api.openai.com/v1
PKV_EMBD_API_KEY=your-embedding-api-key-here

# Embedding model name.
# Override this when using a local model server with a different model name.
# Do not switch this casually: existing vector indexes and stored embeddings were
# generated by the previous model. If the model changes, rebuild/regenerate
# document and chunk embeddings before relying on vector or hybrid retrieval.
# Examples:
#   PKV_EMBD_MODEL=text-embedding-3-small     (OpenAI official)
#   PKV_EMBD_MODEL=text-embedding-ada-002      (OpenAI legacy)
#   PKV_EMBD_MODEL=qwen3-embedding-8b          (LM Studio local)
PKV_EMBD_MODEL=text-embedding-3-small

# Embedding vector dimensions.
# 支持设置为 auto：首次成功请求后自动锁定实际返回维度
# 若本地 OpenAI-compatible 服务忽略 `dimensions` 参数，推荐使用 auto
# 默认建议保持 1536，与现有 OpenAI `text-embedding-3-small` 索引兼容
# 若使用支持缩维的 OpenAI-compatible 服务（如 Qwen 本地服务），也可显式请求 1536
# Common values:
#   auto  — 自动探测首次成功返回的真实维度
#   1536  — text-embedding-3-small / text-embedding-ada-002
#   3072  — text-embedding-3-large
#   4096  — Qwen3-Embedding-8B (默认输出，可缩到 1536)
# IMPORTANT: Changing model or dimensions requires rebuilding the vector index
# and regenerating embeddings. Prefer keeping the current model unless this is
# an intentional index migration.
# PKV_EMBD_DIM=auto

# ====================== OPTIONAL COOKIES =====================
# Zhihu login Cookie (optional, for accessing login-restricted content)
# How to obtain:
#   1. Log in to zhihu.com in your browser
#   2. Open Developer Tools (F12) → Network tab
#   3. Refresh the Zhihu page and click any request
#   4. Copy the full Cookie value from Request Headers
# Note: Cookie contains multiple semicolon-separated key=value pairs
# ZHIHU_COOKIE=_zap=xxx; d_c0=xxx; _xsrf=xxx; ...

# ====================== OPTIONAL PATHS ======================
# Base data directory (default: .data)
# DATA_DIR=.data

# SQLite database path (default: .data/db/knowledge_vault.db)
# DB_PATH=.data/db/knowledge_vault.db

# Vault storage directory for Markdown items (default: .data/vault)
# VAULT_DIR=.data/vault

# Vector index directory (default: .data/vectors)
# VECTOR_STORE_PATH=.data/vectors

# Logs directory (default: .data/logs)
# LOG_DIR=.data/logs

# ====================== OPTIONAL LOGGING ====================
# Log level (DEBUG, INFO, WARNING, ERROR). Default: INFO
# LOG_LEVEL=INFO

# ====================== NOTES ===============================
# 1) PKV_LLM_API_KEY and PKV_EMBD_API_KEY are required for AI + embedding flows.
# 2) Optional values override defaults in the config system.
# 3) Use absolute paths if you keep data outside the repo.
# 4) After changes, restart the CLI to reload env vars.
# 5) Keep this file out of version control if it has secrets.
# 6) Do not wrap values in quotes unless they contain spaces.
# 7) Example: DATA_DIR=D:/pkv-data
