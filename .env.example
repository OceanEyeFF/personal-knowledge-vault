# Personal Knowledge Vault - legacy compatibility notice
#
# PKV no longer loads API configuration from .env files.
# Create the machine-local YAML configuration instead:
#
#   Copy-Item config/config.yaml config/local.yaml
#   notepad config/local.yaml
#
# Store LLM, Embedding and processor credentials only in config/local.yaml.
# The file is ignored by Git. Process environment variables are reserved for
# one-off runtime isolation such as DATA_DIR/DB_PATH/VAULT_DIR/VECTOR_DIR.
