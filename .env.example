# Personal Knowledge Vault - Environment Variables Template
# Copy this file to .env and replace placeholder values
# Lines starting with # are comments and safe to keep

# ====================== REQUIRED KEYS ======================
# DeepSeek API Key (used for analysis, summarization, tagging)
# Get it from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# OpenAI API Key (used for embeddings and vector search)
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# ====================== OPTIONAL API ENDPOINTS ===============
# OpenAI-compatible API base URL for Embedding service
# Use this if you run a local model server (e.g. LM Studio, Ollama)
# or need an API proxy. Default: https://api.openai.com/v1
# Examples:
#   OPENAI_BASE_URL=http://localhost:1234/v1       (LM Studio)
#   OPENAI_BASE_URL=http://localhost:11434/v1      (Ollama)
#   OPENAI_BASE_URL=https://your-proxy.com/v1     (API proxy)
# OPENAI_BASE_URL=http://localhost:1234/v1

# DeepSeek API base URL (default: https://api.deepseek.com/v1)
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ====================== OPTIONAL MODELS =====================
# DeepSeek chat model name (default: deepseek-chat)
# Examples: deepseek-chat, deepseek-reasoner
# DEEPSEEK_MODEL=deepseek-chat

# OpenAI embedding model (default: text-embedding-3-small from config.yaml)
# Override this when using a local model server with a different model name
# Examples:
#   OPENAI_EMBEDDING_MODEL=text-embedding-3-small     (OpenAI official)
#   OPENAI_EMBEDDING_MODEL=text-embedding-ada-002      (OpenAI legacy)
#   OPENAI_EMBEDDING_MODEL=qwen3-embedding-8b          (LM Studio local)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Embedding vector dimensions (default: 1536 from config.yaml)
# Must match the output dimension of your embedding model
# Common values:
#   1536  — text-embedding-3-small / text-embedding-ada-002
#   3072  — text-embedding-3-large
#   4096  — Qwen3-Embedding-8B (default output)
# IMPORTANT: Changing this requires rebuilding the vector index!
# OPENAI_EMBEDDING_DIM=1536

# ====================== OPTIONAL COOKIES =====================
# Zhihu login Cookie (optional, for accessing login-restricted content)
# How to obtain:
#   1. Log in to zhihu.com in your browser
#   2. Open Developer Tools (F12) → Network tab
#   3. Refresh the Zhihu page and click any request
#   4. Copy the full Cookie value from Request Headers
# Note: Cookie contains multiple semicolon-separated key=value pairs
# ZHIHU_COOKIE=_zap=xxx; d_c0=xxx; _xsrf=xxx; ...

# ====================== OPTIONAL PATHS ======================
# Base data directory (default: .data)
# DATA_DIR=.data

# SQLite database path (default: .data/db/knowledge_vault.db)
# DB_PATH=.data/db/knowledge_vault.db

# Vault storage directory for Markdown items (default: .data/vault)
# VAULT_DIR=.data/vault

# Vector index directory (default: .data/vectors)
# VECTOR_STORE_PATH=.data/vectors

# Logs directory (default: .data/logs)
# LOG_DIR=.data/logs

# ====================== OPTIONAL LOGGING ====================
# Log level (DEBUG, INFO, WARNING, ERROR). Default: INFO
# LOG_LEVEL=INFO

# ====================== NOTES ===============================
# 1) DEEPSEEK_API_KEY and OPENAI_API_KEY are required.
# 2) Optional values override defaults in the config system.
# 3) Use absolute paths if you keep data outside the repo.
# 4) After changes, restart the CLI to reload env vars.
# 5) Keep this file out of version control if it has secrets.
# 6) Do not wrap values in quotes unless they contain spaces.
# 7) Example: DATA_DIR=D:/pkv-data
