  "fail_closed_release_blockers": [
    {
      "id": "conda-native-license-materials-and-spdx",
      "condition": "The actual product payload includes a closure-selected subset of native components from the locked 21-package Conda registry and native payload owned by CPython, the PyInstaller bootloader, and runtime distributions. The registry currently binds only Conda package metadata license names and provenance, while complete embedded-native closure and materials have not been mapped for known cases including CPython/libmpdec, the PyInstaller bootloader/zlib, NumPy/bundled native subcomponents, cffi/libffi, cryptography/OpenSSL/Rust, hnswlib/pybind11, jiter, pydantic-core, rpds-py, lxml/libxml2/libxslt, and PyYAML/LibYAML. Complete distributable license materials, audited SPDX expressions or reviewed LicenseRefs, and file-level provenance are therefore not yet bound for every shipped native component.",
      "resolution": "Audit every selector-matched native payload owner, including each included Conda package, CPython runtime component, PyInstaller bootloader, and native runtime distribution; bind the relevant upstream SBOM files and reachable subcomponent set by hash; freeze applicable license and notice materials with immutable provenance; and record a valid SPDX expression or an explicit reviewed LicenseRef for every actual payload component.",
      "affected_component_selectors": [
        "component:*[native-payload]",
        "conda-package:*"
      ]
    },
    {
      "id": "html2text-gpl-compliance",
      "condition": "The html2text component is embedded in the frozen application, but the complete GPL distribution decision is unresolved: its exact SPDX expression, combined-work licensing treatment, corresponding-source scope and durable location, and whole-work license and notice obligations have not all been approved and bound.",
      "resolution": "Obtain legal and release-owner approval for every machine-listed requirement, bind the resulting decisions and durable source location to the final payload, and include the required whole-work license and notice materials.",
      "resolution_requirements": [
        "combined-work-licensing-decision",
        "corresponding-source-scope-and-persistent-location",
        "spdx-license-expression",
        "whole-work-license-and-notices"
      ]
    },
    {
      "id": "native-msvc-license-and-provenance",
      "condition": "The actual product payload includes Microsoft Visual C++ runtime DLLs vendored by PySide6/shiboken6 wheels, but exact Microsoft component version, license material, provenance, and redistribution evidence are not yet bound for every file.",
      "resolution": "Identify every MSVC/UCRT payload file from the actual PyInstaller closure, bind its file version and Microsoft provenance, and include the applicable license and redistribution evidence."
    },
    {
      "id": "qt-corresponding-source-location",
      "condition": "The release does not publish a durable exact corresponding-source location and any required installation information for its Qt/PySide6 binaries.",
      "resolution": "Freeze and publish the exact source archives and distributor modifications, then place that location in the installed notice."
    },
    {
      "id": "qt-linkage-and-replacement-not-proven",
      "condition": "The final packaged artifact has not demonstrated dynamic linkage and successful replacement with a compatible modified Qt/PySide6 library.",
      "resolution": "Test the installed artifact, updater, signature checks, and repair flow against the published replacement procedure."
    },
    {
      "id": "qt-module-license-audit",
      "condition": "The exact set of shipped Qt modules, plugins, codecs, and third-party payloads has not been audited for module-specific terms.",
      "resolution": "Inventory the final payload and confirm LGPL eligibility or other required licensing for every shipped file."
    },
    {
      "id": "qt-notice-placeholders",
      "condition": "Any angle-bracket placeholder remains in the installed Qt/PySide6 user notice.",
      "resolution": "Populate paths, exact source location, modification status, and replacement instructions from the final artifact."
    }
  ]
