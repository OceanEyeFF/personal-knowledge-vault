{
  "schema_version": "pkv.m13.w4-driver-scenarios.v2",
  "runner_version": "pkv.m13.artifact-runner.v2",
  "artifact_version": "0.8.1",
  "ordered_scenarios": [
    {
      "scenario_id": "w4.release_audit.v1",
      "matrix_rows": [
        "payload_and_provenance",
        "documentation_version_and_decision"
      ],
      "handler": "release_audit",
      "timeout_seconds": 120,
      "requires_harness": false
    },
    {
      "scenario_id": "w4.application_lifecycle.v1",
      "matrix_rows": ["installation_and_first_run"],
      "handler": "application_lifecycle",
      "timeout_seconds": 180,
      "requires_harness": false
    },
    {
      "scenario_id": "w4.url_archive_ssrf_rejection.v1",
      "matrix_rows": ["url_security_rejection"],
      "handler": "url_archive_ssrf_rejection",
      "timeout_seconds": 120,
      "requires_harness": false
    },
    {
      "scenario_id": "w4.semantic_provider_unavailable.v1",
      "matrix_rows": ["semantic_provider_unavailable"],
      "handler": "semantic_provider_unavailable",
      "timeout_seconds": 120,
      "requires_harness": false
    },
    {
      "scenario_id": "w4.mcp_stdio_call.v1",
      "matrix_rows": ["mcp_stdio_lifecycle"],
      "handler": "mcp_stdio_call",
      "timeout_seconds": 180,
      "requires_harness": false
    },
    {
      "scenario_id": "w4.offline_text_archive.v1",
      "matrix_rows": ["offline_text_archive"],
      "handler": "offline_text_archive",
      "timeout_seconds": 240,
      "requires_harness": false
    },
    {
      "scenario_id": "w4.bm25_search.v1",
      "matrix_rows": ["cli_read_and_bm25"],
      "handler": "bm25_search",
      "timeout_seconds": 240,
      "requires_harness": false
    },
    {
      "scenario_id": "w4.upgrade_rejection.v1",
      "matrix_rows": ["upgrade_rejection"],
      "handler": "upgrade_rejection",
      "timeout_seconds": 240,
      "requires_harness": false
    },
    {
      "scenario_id": "w4.uninstall_data_retention.v1",
      "matrix_rows": ["uninstall_and_data_boundary"],
      "handler": "uninstall_data_retention",
      "timeout_seconds": 240,
      "requires_harness": false
    }
  ],
  "required_matrix_rows": [
    "payload_and_provenance",
    "installation_and_first_run",
    "cli_read_and_bm25",
    "offline_text_archive",
    "url_security_rejection",
    "semantic_provider_unavailable",
    "mcp_stdio_lifecycle",
    "upgrade_rejection",
    "uninstall_and_data_boundary",
    "documentation_version_and_decision"
  ],
  "required_artifact_files": [
    "app/pkv.exe",
    "app/pkv-mcp.exe",
    "Install.ps1",
    "Uninstall.ps1",
    "LICENSE",
    "THIRD-PARTY-NOTICES.txt",
    "USER-GUIDE.md",
    "COMPLIANCE-HOLD.txt",
    "licenses/index.json",
    "build-info.json",
    "dependency-manifest.json",
    "release-inventory.json",
    "sbom.cdx.json",
    "payload-manifest.json"
  ],
  "mcp": {
    "protocol_version": "2025-11-25",
    "tools": [
      "archive_text",
      "archive_url",
      "collect_evidence",
      "contrast",
      "explain_relation",
      "find_bridges",
      "get_entry",
      "get_related",
      "get_stats",
      "list_entries",
      "list_tags",
      "query_subgraph",
      "search_knowledge",
      "timeline_of"
    ],
    "resources": ["pkv://stats", "pkv://tags"],
    "resource_templates": [
      "pkv://entries/{knowledge_id}",
      "pkv://entries/{knowledge_id}/chunk-index/{chunk_index}",
      "pkv://entries/{knowledge_id}/chunks/{chunk_id}",
      "pkv://entries/{knowledge_id}/metadata",
      "pkv://entries/{knowledge_id}/metadata/{field_name}",
      "pkv://relations/by-edge/{source_knowledge_id}/{target_knowledge_id}/{relation_type}/{relation_source_type}",
      "pkv://relations/{relation_id}"
    ],
    "prompts": ["idea_sharpen", "knowledge_qa", "search_and_summarize"]
  }
}
